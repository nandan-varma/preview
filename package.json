{
  "name": "chrome-extension-boilerplate-react-vite",
  "version": "0.0.1",
  "description": "chrome extension boilerplate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jonghakseo/chrome-extension-boilerplate-react-vite.git"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:firefox": "tsc --noEmit && cross-env __FIREFOX__=true vite build",
    "build:watch": "cross-env __DEV__=true vite build -w --mode development",
    "build:firefox:watch": "cross-env __DEV__=true __FIREFOX__=true vite build -w --mode development",
    "build:hmr": "rollup --config utils/reload/rollup.config.mjs",
    "wss": "node utils/reload/initReloadServer.js",
    "dev": "pnpm build:hmr && (run-p wss build:watch)",
    "dev:firefox": "pnpm build:hmr && (run-p wss build:firefox:watch)",
    "test": "vitest",
    "commitlint": "commitlint --edit",
    "lint": "eslint src",
    "lint:fix": "pnpm lint --fix",
    "prettier": "prettier . --write",
    "prepare": "husky install"
  },
  "type": "module",
  "dependencies": {
    "construct-style-sheets-polyfill": "3.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "webextension-polyfill": "0.12.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-sucrase": "^5.1.0",
    "@rollup/plugin-typescript": "12.3.1",
    "@testing-library/react": "16.3.3",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "4.7.0",
    "chokidar": "6.0.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fs-extra": "11.4.1",
    "husky": "9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "17.6.0",
    "magic-string": "^1.4.5",
    "npm-run-all2": "^9.0.4",
    "prettier": "3.9.10",
    "rollup": "4.67.4",
    "sass": "1.107.1",
    "ts-loader": "9.6.2",
    "tslib": "2.9.1",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "^5.1.0",
    "ws": "8.22.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@8.9.2",
  "pnpm": {
    "overrides": {
      "undici": ">=8.12.2",
      "fast-uri": ">=3.1.9"
    }
  }
}
